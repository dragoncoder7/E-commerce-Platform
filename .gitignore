# dependencies
node_modules
.pnpm-store

# build output
dist
dist-ssr
build
target
*.local

# logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# editor / os
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# typescript cache
*.tsbuildinfo

# env (本地私有配置，模板见 admin/.env.example)
.env.local
.env.*.local

# 本地工具目录
.workbuddy/
