# 复制为 application-local.yml；密钥由环境变量注入，不提交本地文件。
server:
  port: 8081
spring:
  application:
    name: erp-service
  cloud:
    nacos:
      discovery:
        server-addr: ${NACOS_ADDRESS:localhost:8848}
      config:
        server-addr: ${NACOS_ADDRESS:localhost:8848}
        file-extension: yml
  datasource:
    url: ${SPRING_DATASOURCE_URL:jdbc:mysql://localhost:3306/ecommerce_system?serverTimezone=Asia/Shanghai}
    username: ${SPRING_DATASOURCE_USERNAME:root}
    password: ${SPRING_DATASOURCE_PASSWORD}
  data:
    redis:
      host: ${SPRING_DATA_REDIS_HOST:localhost}
      port: ${SPRING_DATA_REDIS_PORT:6379}
jwt:
  secret: ${ERP_JWT_SECRET}
  audience: erp
  expiration: 7200000
mail:
  enabled: false
