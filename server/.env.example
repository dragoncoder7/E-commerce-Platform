# MySQL 配置
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=ecommerce_system

# Redis 配置（可选，默认无密码）
# REDIS_PASSWORD=

# Nacos 配置
NACOS_MODE=standalone
NACOS_JVM_XMS=512m
NACOS_JVM_XMX=512m

# 应用配置
SPRING_PROFILES_ACTIVE=docker

# 复制为 .env.local 后填写；Docker Compose 通过 --env-file .env.local 加载
# Docker 模式不读取 application-local.yml 中的密钥
RESEND_API_KEY=

# JVM 配置
GATEWAY_JAVA_OPTS=-Xms512m -Xmx512m
SYSTEM_SERVICE_JAVA_OPTS=-Xms512m -Xmx512m
