# MySQL 配置
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=ecommerce_system

# Redis 配置（可选，默认无密码）
# REDIS_PASSWORD=

# Nacos 配置
NACOS_MODE=standalone
NACOS_JVM_XMS=512m
NACOS_JVM_XMX=512m

# 应用配置
SPRING_PROFILES_ACTIVE=docker

# JVM 配置
GATEWAY_JAVA_OPTS=-Xms512m -Xmx512m
SYSTEM_SERVICE_JAVA_OPTS=-Xms512m -Xmx512m
